# VitalGraph runtime data. The default config paths are relative to the working
# directory, so running the server or importing its module from the repository
# root creates these here rather than under vitalgraph/ -- match them at any
# depth, not just inside the subproject.
vitalgraph_data/
vg_rag_storage/
*.duckdb
vitalgraph_models/
