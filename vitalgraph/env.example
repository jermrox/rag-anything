# --- VitalGraph -------------------------------------------------------------
# Copy to .env and adjust. Every value has a working default.

VITALGRAPH_DATA_DIR=./vitalgraph_data
VITALGRAPH_DB=./vitalgraph_data/biometrics.db
VITALGRAPH_USER=default

# Rolling window (nights) for the personal HRV baseline.
VITALGRAPH_BASELINE_NIGHTS=14

VITALGRAPH_HOST=127.0.0.1
VITALGRAPH_PORT=8770

# --- RAG (optional) ---------------------------------------------------------
# Only needed for /api/query and /api/rag/ingest. Analytics work without these.
VITALGRAPH_RAG_DIR=./vg_rag_storage
LLM_BINDING_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
# LLM_BINDING_HOST=https://api.openai.com/v1
